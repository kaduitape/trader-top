# =============================================================================
# MT5 AI Scalper — Variaveis de ambiente
# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA versione o arquivo ".env" (ja esta listado em .gitignore).
# Todos os valores abaixo sao placeholders — substitua antes de usar.
# =============================================================================

# --- Aplicacao -----------------------------------------------------------
APP_NAME="MT5 AI Scalper"
APP_ENV=development          # development | test | staging | production
APP_DEBUG=true
APP_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
APP_HOST=0.0.0.0
APP_PORT=8000

# Modo do sistema no boot. Deve permanecer DISABLED ate as fases de execucao
# existirem. Nunca defina REAL_ENABLED aqui.
SYSTEM_MODE=DISABLED

# --- Autenticacao / JWT ----------------------------------------------------
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ATENCAO: bypass de desenvolvimento -- NUNCA true em producao. Libera as
# paginas do dashboard sem login, autenticando automaticamente como um
# usuario "dev" (ADMIN, criado sob demanda). Nao afeta /api/* (JWT continua
# exigido). Deixe false/comentado assim que voce resolver login/senha.
DASHBOARD_AUTH_DISABLED=false

# --- Banco de dados (MySQL 8) ----------------------------------------------
# Preencha com um servidor MySQL 8 real quando disponivel.
# Ate la, a suite de testes usa SQLite em memoria automaticamente.
DB_DRIVER=mysql+pymysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mt5_ai_scalper
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10
DB_ECHO=false

# Docker publica o MySQL somente em 127.0.0.1 para o conector MT5 do Windows.
# Altere apenas se a porta 3306 ja estiver em uso no host.
DB_EXPOSED_PORT=3306
DB_ROOT_PASSWORD=CHANGE_ME_root

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_JSON=true

# --- MetaTrader 5 (conector somente leitura, Fase 2) ------------------------
# Preencha para coletar dados de um terminal MT5 real (demo ou real) ja
# instalado e autenticado nesta maquina Windows. Sem estes valores, os
# comandos "mt5 check" / "collect candles" / "collect ticks" da CLI falham
# com uma mensagem clara — nada e inventado ou simulado como resposta real
# do terminal.
MT5_TERMINAL_PATH="C:\\Program Files\\MetaTrader 5\\terminal64.exe"
MT5_LOGIN=CHANGE_ME
MT5_PASSWORD=CHANGE_ME
MT5_SERVER=CHANGE_ME
MT5_TIMEOUT_MS=10000
MT5_MAX_RECONNECT_ATTEMPTS=5
MT5_RECONNECT_BACKOFF_SECONDS=2.0
MT5_HEARTBEAT_INTERVAL_SECONDS=30.0

# --- Qualidade de dados e retencao (Fase 3) ---------------------------------
QUALITY_MAX_SPREAD_POINTS=50.0
QUALITY_MAX_FEED_DELAY_SECONDS=300
QUALITY_MIN_SCORE=70
TICK_RETENTION_DAYS=30

# --- Machine learning (Fase 8) -----------------------------------------------
ML_DATASETS_DIR=datasets
ML_MODELS_DIR=models

# --- Noticias/fundamentos externos (Fase 18.6) ------------------------------
# Opcional. Sem preencher (aqui ou via /dashboard/settings/aisa), o motor de
# analise (Fase 18) usa um provedor "nao configurado" que contribui neutro no
# score composto -- nunca inventa noticia/sentimento. Preencher a chave AINDA
# NAO ativa um provedor real (nenhum contrato HTTP da API AIsa foi
# documentado/implementado nesta fase) -- ver app/news/factory.py.
AISA_API_KEY=
AISA_API_BASE_URL=

# --- Motor de analise Price Action / SMC / multi-timeframe (Fase 18) --------
ANALYSIS_DEFAULT_TIMEFRAME=M15
ANALYSIS_DEFAULT_THRESHOLD=90.0

# Executa migrations + preflight antes de iniciar o servidor no Docker.
# Mantenha true; use false apenas em diagnosticos controlados.
RUN_PREFLIGHT=true

# =============================================================================
# Alertas (email/Telegram/etc.) ainda NAO existem neste projeto. Drift de
# modelo e saude do feed (Fase 13) sao detectados e persistidos em
# "drift_events" e visiveis em /dashboard/drift e "python -m app.cli monitor
# model/feed" — nao ha, por enquanto, notificacao por um canal externo.
# Antes de operar por um periodo estendido, rode "python -m app.cli
# preflight check" (Fase 15) para validar este arquivo (.env) de ponta a
# ponta: segredo de aplicacao, banco/migrations, diretorios de artefato e
# credenciais MT5.
# =============================================================================
